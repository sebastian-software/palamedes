{
  "name": "@palamedes/site",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node ./scripts/prebuild-content.mjs",
    "dev": "node ./scripts/prebuild-content.mjs && react-router dev --port 4100",
    "build": "node ../scripts/verify-site-bench-data.mjs && node ./scripts/generate-og-images.mjs --check && node ./scripts/prebuild-content.mjs && react-router build && node ../scripts/copy-llms-to-site.mjs",
    "preview": "sirv build/client --single --port 4101",
    "typecheck": "node ./scripts/prebuild-content.mjs && react-router typegen && tsc"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@palamedes/site-ui": "workspace:*",
    "@react-router/node": "8.3.0",
    "ardo": "4.2.0",
    "isbot": "^5.2.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "sirv-cli": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  }
}
