{
  "include": ["app/**/*", "vite.config.ts"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "ardo/vite/client", "ardo/virtual"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./app/*"],
      "ardo/jsx-runtime": ["./node_modules/ardo/dist/react/jsx-runtime.d.ts"],
      "ardo/jsx-dev-runtime": ["./node_modules/ardo/dist/react/jsx-dev-runtime.d.ts"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "jsxImportSource": "ardo"
  },
  "extends": "ardo/tsconfig"
}
