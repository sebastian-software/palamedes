{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": "..",
    "types": ["node"]
  },
  "include": ["../packages/*/src/**/*"],
  "exclude": ["../packages/**/*.test.ts", "../packages/**/*.test.tsx"]
}
