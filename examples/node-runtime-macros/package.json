{
  "name": "@palamedes/example-node-runtime-macros",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n": "pmds extract --runtime-manifest .palamedes/macros.json && pmds catalog compile --target js --output .palamedes/catalogs",
    "build": "pnpm i18n && tsc",
    "start": "node src/cli.ts",
    "test": "node --test test/runtime-macros.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@palamedes/core": "workspace:^",
    "@palamedes/runtime": "workspace:^"
  },
  "devDependencies": {
    "@palamedes/cli": "workspace:^",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
