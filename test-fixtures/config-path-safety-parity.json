{
  "validLocales": ["en", "de-DE", "zh-Hans", "pt.BR", "en_US", "en-US-x-twain", "pseudo"],
  "invalidLocales": [
    "",
    ".",
    "..",
    "../en",
    "..\\en",
    "../../../tmp/out",
    "en/de",
    "en\\de",
    ".hidden",
    "en.",
    "en..de",
    "-en",
    "en-",
    "en\u0000",
    "en de",
    "C:en"
  ],
  "validCatalogPaths": [
    "locales/{locale}",
    "src/locales/{locale}/messages.v2",
    "./locales/{locale}",
    "locales\\{locale}\\messages.v2"
  ],
  "invalidCatalogPaths": [
    "",
    "   ",
    ".",
    "./",
    "/etc/locales/{locale}",
    "\\windows\\locales\\{locale}",
    "C:/locales/{locale}",
    "C:\\locales\\{locale}",
    "./C:/outside/{locale}",
    ".\\C:\\outside\\{locale}",
    "./C:outside/{locale}",
    "././D:/locales/{locale}",
    "{locale}:/evil",
    "./{locale}:/evil",
    "../outside/{locale}",
    "locales/../../outside/{locale}",
    "locales\\..\\..\\outside\\{locale}",
    "locales/{locale}/",
    "locales\\{locale}\\",
    "locales/{locale}/.",
    "locales\\{locale}\\.",
    "locales/\u0000/{locale}",
    ".pmds-lock/{locale}",
    "locales/.PMDS-LOCK/{locale}",
    "locales/.pmds-lock./{locale}",
    "locales/.pmds\u200b-lock/{locale}",
    "locales/{locale}/.pmds-lock"
  ],
  "resourcePathParity": [
    { "path": "{locale}\\.po", "locale": "en", "format": "po", "expectedRelative": "en/.po.po" },
    {
      "path": "locales\\{locale}\\messages.po",
      "locale": "en",
      "format": "po",
      "expectedRelative": "locales/en/messages.po"
    },
    {
      "path": ".\\locales\\{locale}",
      "locale": "en",
      "format": "po",
      "expectedRelative": "locales/en.po"
    },
    {
      "path": "./locales//{locale}/messages",
      "locale": "de",
      "format": "po",
      "expectedRelative": "locales/de/messages.po"
    },
    {
      "path": "locales\\{locale}\\messages.PO",
      "locale": "de",
      "format": "po",
      "expectedRelative": "locales/de/messages.po"
    },
    {
      "path": "locales\\{locale}\\messages.",
      "locale": "de",
      "format": "po",
      "expectedRelative": "locales/de/messages.po"
    },
    {
      "path": "locales\\{locale}\\messages.v2.",
      "locale": "pt.BR",
      "format": "po",
      "expectedRelative": "locales/pt.BR/messages.v2.po"
    },
    {
      "path": "locales\\{locale}\\messages.v2",
      "locale": "pt.BR",
      "format": "po",
      "expectedRelative": "locales/pt.BR/messages.v2.po"
    },
    {
      "path": "locales\\{locale}\\messages.fcl",
      "locale": "de",
      "format": "fcl",
      "expectedRelative": "locales/de/messages.fcl"
    },
    {
      "path": "locales\\{locale}\\messages.FCL",
      "locale": "de",
      "format": "fcl",
      "expectedRelative": "locales/de/messages.fcl"
    }
  ]
}
