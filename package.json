{
  "name": "palamedes",
  "private": true,
  "description": "Rust-powered i18n tooling for TypeScript with one coherent source-to-runtime architecture",
  "homepage": "https://palamedes.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/palamedes.git"
  },
  "bugs": "https://github.com/sebastian-software/palamedes/issues",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "test:llms": "node --test ./scripts/check-llms-surface.test.mjs",
    "test:nextjs-first-run": "node --test ./scripts/check-nextjs-first-run.mjs",
    "check:llms": "node ./scripts/check-llms-surface.mjs && pnpm test:llms",
    "test:core-api-reference": "node --test ./scripts/check-core-api-reference.test.mjs",
    "test:readme": "node --test ./scripts/check-readme-ia.test.mjs",
    "test:site-route-errors": "node --test ./scripts/verify-site-route-errors.test.mjs",
    "check:readme": "node ./scripts/check-readme-ia.mjs && pnpm test:readme",
    "test:decisions": "node --test ./scripts/check-decisions-index.test.mjs",
    "check:decisions": "node ./scripts/check-decisions-index.mjs && pnpm test:decisions",
    "test:release-packages": "node --test ./scripts/release-packages.test.mjs ./scripts/publish-package-if-needed.test.mjs ./scripts/build-native-lib.test.mjs ./scripts/check-binary-size.test.mjs ./scripts/published-export-contracts.test.mjs",
    "test:backend-guide": "pnpm --filter @palamedes/core --filter @palamedes/runtime build && node --test ./scripts/backend-guide-contract.test.mjs",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "build:examples": "pnpm -r --filter \"./examples/**\" build",
    "build:site": "pnpm --filter @palamedes/site build",
    "dev:site": "pnpm --filter @palamedes/site dev",
    "container:ports": "node ./scripts/container/print-podman-ports.mjs",
    "capture:example-screenshots": "node ./scripts/capture-example-screenshots.mjs",
    "verify:examples": "pnpm build && node ./scripts/verify-examples-all.mjs",
    "check:example-matrix": "node ./scripts/check-example-matrix.mjs",
    "check:example-contracts": "vitest run scripts/example-matrix-guard.test.mjs scripts/example-sibling-parity.test.mjs scripts/container/start-plan.test.mjs",
    "verify:example-time-zone-contract": "vitest run scripts/example-time-zone-contract.test.mjs",
    "verify:examples:smoke": "node ./scripts/verify-examples.mjs",
    "verify:examples:browser": "node ./scripts/verify-examples-browser.mjs",
    "verify:react-router-rsc": "node ./scripts/verify-react-router-rsc.mjs",
    "verify:site-routes": "node ./scripts/verify-site-routes.mjs",
    "verify:site-a11y": "node ./scripts/verify-site-a11y.mjs",
    "verify:site-docs-dev": "node ./site/scripts/verify-docs-development.mjs",
    "verify:site-streamline": "node ./scripts/verify-site-streamline-assets.mjs",
    "benchmark:proof": "pnpm build && node ./scripts/benchmark-proof.mjs",
    "benchmark:proof:large": "pnpm build && node ./scripts/benchmark-proof.mjs --large-messages 10000",
    "bench:e2e": "pnpm benchmark:e2e-workflow",
    "benchmark:e2e-workflow": "cargo build --release -p palamedes-cli && pnpm --filter @palamedes/benchmark-e2e-workflow benchmark",
    "benchmark:e2e-workflow:quick": "cargo build --release -p palamedes-cli && pnpm --filter @palamedes/benchmark-e2e-workflow benchmark:quick",
    "benchmark:lingui-v6": "pnpm build && pnpm --filter @palamedes/benchmark-lingui-v6 benchmark",
    "benchmark:lingui-v6:quick": "pnpm build && pnpm --filter @palamedes/benchmark-lingui-v6 benchmark:quick",
    "benchmark:runtime-browser": "pnpm build && pnpm --filter @palamedes/example-vite-mdx build && node ./scripts/check-runtime-browser-bundle.mjs",
    "proof:icu": "pnpm build && node ./scripts/proof-icu-semantics.mjs",
    "proof:icu:check": "node ./scripts/proof-icu-semantics.mjs",
    "test": "pnpm test:llms && pnpm test:readme && pnpm test:core-api-reference && pnpm test:nextjs-first-run && pnpm test:decisions && pnpm test:release-packages && pnpm test:site-route-errors && pnpm test:backend-guide && pnpm --workspace-concurrency=1 -r --filter \"./packages/**\" --if-present test && pnpm --filter @palamedes/site test && pnpm check:example-contracts && pnpm check:workflow-contracts",
    "test:coverage": "vitest run --config vitest.coverage.config.mts --coverage",
    "test:platform": "pnpm -r --filter @palamedes/config --filter @palamedes/core-node --filter @palamedes/next-plugin --filter @palamedes/tanstack --filter @palamedes/vite-plugin test",
    "check:binary-size": "node ./scripts/check-binary-size.mjs",
    "check:native-types": "pnpm --filter @palamedes/core-node check-native-types",
    "check:published-types": "node ./scripts/check-published-types.mjs && pnpm check:core-api-reference",
    "check:core-api-reference": "node ./scripts/check-core-api-reference.mjs",
    "check:release-set": "node ./scripts/check-release-set.mjs",
    "check:workflow-contracts": "vitest run scripts/workflow-contracts.test.mjs scripts/native-package-contracts.test.mjs scripts/release-verification.test.mjs",
    "check-types": "pnpm check:native-types && pnpm -r --filter \"./packages/**\" exec tsc --noEmit -p tsconfig.json",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:fix": "pnpm lint:oxlint:fix && pnpm lint:eslint:fix",
    "lint:oxlint": "oxlint --config .oxlintrc.json --ignore-path .gitignore --deny-warnings .",
    "lint:oxlint:fix": "oxlint --config .oxlintrc.json --ignore-path .gitignore --fix --deny-warnings .",
    "lint:eslint": "eslint --max-warnings=0 \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "lint:eslint:fix": "eslint --fix --max-warnings=0 \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "format": "oxfmt --write --ignore-path .gitignore --ignore-path .oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore .",
    "build:native": "cargo build --workspace",
    "check:rust": "cargo check --workspace",
    "test:rust": "cargo test --workspace",
    "agent:check": "pnpm build && concurrently --kill-others-on-fail --group --names release,published-types,llms,decisions,format,lint,test,types,rustfmt,rust \"pnpm check:release-set\" \"pnpm check:published-types\" \"pnpm check:llms\" \"pnpm check:decisions\" \"pnpm format:check\" \"pnpm lint\" \"pnpm test\" \"pnpm check-types\" \"cargo fmt --all --check\" \"cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-setup": "^0.5.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
