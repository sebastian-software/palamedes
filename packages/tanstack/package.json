{
  "name": "@palamedes/tanstack",
  "version": "1.25.1",
  "description": "TanStack Start request-scoped i18n middleware for Palamedes",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "tanstack-start"
  ],
  "homepage": "https://github.com/sebastian-software/palamedes",
  "bugs": "https://github.com/sebastian-software/palamedes/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/palamedes.git",
    "directory": "packages/tanstack"
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "unbuild",
    "test": "vitest run --globals src/index.test.ts src/server.test.ts && node --test scripts/package.test.mjs",
    "stub": "unbuild --stub"
  },
  "dependencies": {
    "@palamedes/core": "workspace:^",
    "@palamedes/runtime": "workspace:^",
    "@palamedes/vite-plugin": "workspace:^"
  },
  "devDependencies": {
    "@tanstack/react-start": "1.168.49",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@tanstack/react-start": "^1.168.38"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
