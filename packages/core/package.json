{
  "name": "@palamedes/core",
  "version": "1.25.1",
  "description": "Palamedes-owned i18n instance and macro entry points",
  "keywords": [
    "i18n",
    "palamedes",
    "runtime"
  ],
  "homepage": "https://github.com/sebastian-software/palamedes",
  "bugs": "https://github.com/sebastian-software/palamedes/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/palamedes.git",
    "directory": "packages/core"
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compiled": {
      "import": {
        "types": "./dist/compiled.d.mts",
        "default": "./dist/compiled.mjs"
      },
      "require": {
        "types": "./dist/compiled.d.cts",
        "default": "./dist/compiled.cjs"
      }
    },
    "./macro": {
      "import": {
        "types": "./dist/macro.d.mts",
        "default": "./dist/macro.mjs"
      },
      "require": {
        "types": "./dist/macro.d.cts",
        "default": "./dist/macro.cjs"
      }
    },
    "./locale": {
      "import": {
        "types": "./dist/locale.d.mts",
        "default": "./dist/locale.mjs"
      },
      "require": {
        "types": "./dist/locale.d.cts",
        "default": "./dist/locale.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "unbuild",
    "test": "vitest run --globals",
    "stub": "unbuild --stub"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
