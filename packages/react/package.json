{
  "name": "@palamedes/react",
  "version": "1.24.0",
  "description": "React runtime components and macro entry points for Palamedes",
  "keywords": [
    "i18n",
    "palamedes",
    "react"
  ],
  "homepage": "https://github.com/sebastian-software/palamedes",
  "bugs": "https://github.com/sebastian-software/palamedes/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/palamedes.git",
    "directory": "packages/react"
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "import": {
          "types": "./dist/index-server.d.mts",
          "default": "./dist/index-server.mjs"
        },
        "require": {
          "types": "./dist/index-server.d.cts",
          "default": "./dist/index-server.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compiled": {
      "react-server": {
        "import": {
          "types": "./dist/compiled-server.d.mts",
          "default": "./dist/compiled-server.mjs"
        },
        "require": {
          "types": "./dist/compiled-server.d.cts",
          "default": "./dist/compiled-server.cjs"
        }
      },
      "import": {
        "types": "./dist/compiled.d.mts",
        "default": "./dist/compiled.mjs"
      },
      "require": {
        "types": "./dist/compiled.d.cts",
        "default": "./dist/compiled.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./macro": {
      "import": {
        "types": "./dist/macro.d.mts",
        "default": "./dist/macro.mjs"
      },
      "require": {
        "types": "./dist/macro.d.cts",
        "default": "./dist/macro.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "unbuild",
    "test": "vitest run --globals src/index.test.tsx src/clientCatalog.test.tsx src/clientCatalogServer.test.tsx && node --test scripts/exports.test.mjs",
    "stub": "unbuild --stub"
  },
  "dependencies": {
    "@palamedes/core": "workspace:^",
    "@palamedes/runtime": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
