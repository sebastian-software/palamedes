{
  "name": "@palamedes/site-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Palamedes site chrome, layout primitives, and design tokens",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles.css",
    "./tailwind.css": "./tailwind.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "README.md",
    "src/",
    "styles.css",
    "tailwind.css"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run src/index.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
