{
  "name": "@palamedes/core-node",
  "version": "1.23.0",
  "description": "Thin Node.js wrapper around the Palamedes Rust core",
  "keywords": [
    "i18n",
    "napi",
    "native",
    "palamedes",
    "rust"
  ],
  "homepage": "https://github.com/sebastian-software/palamedes",
  "bugs": "https://github.com/sebastian-software/palamedes/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/palamedes.git",
    "directory": "packages/core-node"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate-native-types": "node ./scripts/generate-native-types.mjs",
    "check-native-types": "node ./scripts/generate-native-types.mjs --check",
    "build": "unbuild",
    "pretest": "node ./scripts/build-test-support-addon.mjs",
    "test": "vitest run --globals src/index.test.ts && node --test ./scripts/package.test.mjs",
    "stub": "unbuild --stub"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@palamedes/core-node-darwin-arm64": "workspace:*",
    "@palamedes/core-node-linux-arm64-gnu": "workspace:*",
    "@palamedes/core-node-linux-arm64-musl": "workspace:*",
    "@palamedes/core-node-linux-x64-gnu": "workspace:*",
    "@palamedes/core-node-linux-x64-musl": "workspace:*",
    "@palamedes/core-node-win32-x64-msvc": "workspace:*"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
