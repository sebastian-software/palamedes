{
  "name": "@palamedes/react-router-rsc",
  "version": "1.14.0",
  "description": "Experimental React Router RSC request-scoped i18n for Palamedes",
  "homepage": "https://github.com/sebastian-software/palamedes",
  "repository": {
    "type": "git",
