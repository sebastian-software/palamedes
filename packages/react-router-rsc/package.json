  "peerDependenciesMeta": {
    "@react-router/dev": {
      "optional": true
    },
    "@vitejs/plugin-rsc": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-router/dev": "8.3.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-rsc": "0.5.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0",
    "react-server-dom-webpack": "^19.2.8",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.10",
    "vite": "^8.2.1"
  }
