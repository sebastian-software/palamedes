{
  "name": "@palamedes/eslint-plugin",
  "version": "1.24.0",
  "description": "ESLint and Oxlint adapter for native Palamedes source diagnostics",
  "keywords": [
    "eslint",
    "i18n",
    "lint",
    "oxlint",
    "palamedes"
  ],
  "homepage": "https://github.com/sebastian-software/palamedes",
  "bugs": "https://github.com/sebastian-software/palamedes/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/palamedes.git",
    "directory": "packages/eslint-plugin"
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "unbuild",
    "test": "unbuild && vitest run --globals src/index.test.ts",
    "benchmark": "unbuild && node ./scripts/benchmark.mjs",
    "stub": "unbuild --stub"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.81.0",
    "@palamedes/core-node": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "eslint": ">=9 <11",
    "oxlint": ">=1.76.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
