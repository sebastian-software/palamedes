{
  "name": "@palamedes/solid",
  "version": "1.25.1",
  "description": "Solid runtime components and macro entry points for Palamedes",
  "keywords": [
    "i18n",
    "palamedes",
    "solid"
  ],
  "homepage": "https://github.com/sebastian-software/palamedes",
  "bugs": "https://github.com/sebastian-software/palamedes/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/palamedes.git",
    "directory": "packages/solid"
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compiled": {
      "import": {
        "types": "./dist/compiled.d.mts",
        "default": "./dist/compiled.mjs"
      },
      "require": {
        "types": "./dist/compiled.d.cts",
        "default": "./dist/compiled.cjs"
      }
    },
    "./macro": {
      "import": {
        "types": "./dist/macro.d.mts",
        "default": "./dist/macro.mjs"
      },
      "require": {
        "types": "./dist/macro.d.cts",
        "default": "./dist/macro.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "unbuild",
    "test": "vitest run --globals src/index.test.tsx && vitest run --config vitest.client.config.ts --globals src/client.test.tsx",
    "stub": "unbuild --stub"
  },
  "dependencies": {
    "@palamedes/core": "workspace:^",
    "@palamedes/runtime": "workspace:^"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.37",
    "@solidjs/web": "2.0.0-rc.3",
    "@testing-library/jest-dom": "^6.9.1",
    "solid-js": "2.0.0-rc.3",
    "typescript": "^7.0.2",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0-rc.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
