{
  "name": "@palamedes/cli",
  "version": "1.24.0",
  "description": "Palamedes CLI for extraction, audits, reports, catalog workflows, and native command plugins",
  "keywords": [
    "cli",
    "i18n",
    "internationalization",
    "palamedes"
  ],
  "homepage": "https://github.com/sebastian-software/palamedes",
  "bugs": "https://github.com/sebastian-software/palamedes/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/palamedes.git",
    "directory": "packages/cli"
  },
  "bin": {
    "pmds": "./bin/pmds"
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "bin/pmds",
    "scripts/run.mjs",
    "scripts/platform.mjs",
    "scripts/native.mjs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "node --test ./scripts/platform.test.mjs ./scripts/native.test.mjs && node ./scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@palamedes/cli-darwin-arm64": "workspace:*",
    "@palamedes/cli-linux-arm64-gnu": "workspace:*",
    "@palamedes/cli-linux-arm64-musl": "workspace:*",
    "@palamedes/cli-linux-x64-gnu": "workspace:*",
    "@palamedes/cli-linux-x64-musl": "workspace:*",
    "@palamedes/cli-win32-x64-msvc": "workspace:*"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
