{
  "name": "@palamedes/runtime",
  "version": "1.19.0",
  "description": "Palamedes runtime primitives for resolving the active i18n instance",
  "homepage": "https://github.com/sebastian-software/palamedes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/palamedes.git",
    "directory": "packages/runtime"
  },
  "bugs": "https://github.com/sebastian-software/palamedes/issues",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "node": {
        "import": {
          "types": "./dist/server.d.mts",
          "default": "./dist/server.mjs"
        },
        "require": {
          "types": "./dist/server.d.cts",
          "default": "./dist/server.cjs"
        }
      },
      "browser": {
        "import": {
          "types": "./dist/server-unavailable.d.mts",
          "default": "./dist/server-unavailable.mjs"
        },
        "require": {
          "types": "./dist/server-unavailable.d.cts",
          "default": "./dist/server-unavailable.cjs"
        }
      },
      "default": {
        "import": {
          "types": "./dist/server-unavailable.d.mts",
          "default": "./dist/server-unavailable.mjs"
        },
        "require": {
          "types": "./dist/server-unavailable.d.cts",
          "default": "./dist/server-unavailable.cjs"
        }
      }
    },
    "./server/test": {
      "node": {
        "import": {
          "types": "./dist/server-test.d.mts",
          "default": "./dist/server-test.mjs"
        },
        "require": {
          "types": "./dist/server-test.d.cts",
          "default": "./dist/server-test.cjs"
        }
      },
      "browser": {
        "import": {
          "types": "./dist/server-test-unavailable.d.mts",
          "default": "./dist/server-test-unavailable.mjs"
        },
        "require": {
          "types": "./dist/server-test-unavailable.d.cts",
          "default": "./dist/server-test-unavailable.cjs"
        }
      },
      "default": {
        "import": {
          "types": "./dist/server-test-unavailable.d.mts",
          "default": "./dist/server-test-unavailable.mjs"
        },
        "require": {
          "types": "./dist/server-test-unavailable.d.cts",
          "default": "./dist/server-test-unavailable.cjs"
        }
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "README.md",
    "dist/"
  ],
  "scripts": {
    "build": "unbuild",
    "test": "vitest run --globals src/index.test.ts src/server.test.ts src/server-test.test.ts src/server-unavailable.test.ts",
    "stub": "unbuild --stub"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@palamedes/core": "workspace:^",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.10"
  }
}
