{
  "name": "@palamedes/proof-nuxt-ssr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 4073",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "extract": "pmds extract",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.app.json && vue-tsc --noEmit -p .nuxt/tsconfig.server.json && vue-tsc --noEmit -p .nuxt/tsconfig.node.json",
    "test": "pnpm typecheck && pnpm build && node --test test/browser.test.mjs"
  },
  "dependencies": {
    "@palamedes/core": "link:../../packages/core",
    "@palamedes/example-ui": "link:../../packages/example-ui",
    "@palamedes/runtime": "link:../../packages/runtime",
    "h3": "1.15.11",
    "nuxt": "4.6.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@nuxt/kit": "4.6.2",
    "@palamedes/cli": "link:../../packages/cli",
    "@palamedes/config": "link:../../packages/config",
    "@palamedes/vite-plugin": "link:../../packages/vite-plugin",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "nitropack": "2.13.5",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
