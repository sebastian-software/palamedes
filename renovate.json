{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>sebastian-software/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track digest-pinned Docker images referenced in shell commands of GitHub workflows and composite actions",
      "managerFilePatterns": ["/^\\.github/(?:workflows|actions)/.+\\.ya?ml$/"],
      "matchStrings": [
        "(?:^|[\\s=\"'])(?<depName>(?:[a-z0-9.-]+\\.[a-z0-9.-]+(?::\\d+)?/)?[a-z0-9]+(?:[._/-][a-z0-9]+)*):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Keep musl action Docker image tags aligned with Cargo.toml rust-version and Node 24 by disabling independent tag upgrades",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/actions/verify-musl-native/action.yml"],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major", "minor", "patch", "replacement"],
      "enabled": false
    },
    {
      "description": "Allow digest refreshes for shell-invoked musl verification Docker images",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/actions/verify-musl-native/action.yml"],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "enabled": true,
      "pinDigests": true
    },
    {
      "description": "Keep Containerfile Rust and Node tags aligned with Cargo.toml rust-version and Node 24 by disabling independent tag upgrades",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Containerfile"],
      "matchUpdateTypes": ["major", "minor", "patch", "replacement"],
      "enabled": false
    },
    {
      "description": "Allow digest refreshes for Containerfile base images",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Containerfile"],
      "matchUpdateTypes": ["digest"],
      "enabled": true,
      "pinDigests": true
    }
  ]
}
